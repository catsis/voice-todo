{
  "expo": {
    "name": "語音待辦",
    "slug": "voice-todo",
    "version": "1.1.0",
    "owner": "kurumi030",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "允許「語音待辦」使用語音辨識功能。",
        "NSMicrophoneUsageDescription": "允許「語音待辦」使用麥克風進行語音輸入。"
      }
    },
    "android": {
      "package": "com.kurumi030.voicetodo",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/renameApk",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "允許「語音待辦」使用麥克風進行語音輸入。",
          "speechRecognitionPermission": "允許「語音待辦」使用語音辨識功能。"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "允許「語音待辦」存取相片庫，以便附加圖片至待辦事項。",
          "cameraPermission": "允許「語音待辦」使用相機拍攝照片。"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/e3cae1c6-68f4-4230-9484-6274794f5307"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "e3cae1c6-68f4-4230-9484-6274794f5307"
      }
    }
  }
}
